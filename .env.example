# MindForge Environment Variables (all optional for paper-trading mode)

# Logging level: DEBUG, INFO, WARNING, ERROR
MINDFORGE_LOG_LEVEL=INFO

# --- External Mindshare Feeds (optional; falls back to synthetic/replay if unset) ---
# Kaito-style narrative share API
MINDFORGE_KAITO_API_URL=
MINDFORGE_KAITO_API_KEY=

# X / Twitter or social keyword velocity API
MINDFORGE_SOCIAL_API_URL=
MINDFORGE_SOCIAL_BEARER_TOKEN=

# --- On-Chain Agent Activity Feeds (optional) ---
# Indexer / RPC endpoint for wallet clusters & agent-to-agent transfer metrics
MINDFORGE_ONCHAIN_API_URL=
MINDFORGE_ONCHAIN_API_KEY=

# --- Hyperliquid Live / Vault Execution (NOT needed for paper trading or public data) ---
# Optional Hyperliquid Vault address (0x...) when running as a vault strategy engine
MINDFORGE_HL_VAULT_ADDRESS=
# Private key only required if dry_run=false with a live signer (NEVER commit real keys!)
MINDFORGE_HL_PRIVATE_KEY=

# --- Optional LLM Forecaster ---
MINDFORGE_LLM_API_KEY=
